<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane fx:controller="edu.utsa.cs3443.replog.WorkoutController" prefHeight="600.0" prefWidth="900.0" styleClass="root-pane" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="10.0" style="-fx-background-color: #141414;" styleClass="nav-bar" BorderPane.alignment="CENTER">
            <children>
                <ImageView fx:id="logoImageView" fitHeight="59.0" fitWidth="75.0" pickOnBounds="true" preserveRatio="true" />
                <Label prefHeight="43.0" prefWidth="125.0" styleClass="logo-text" text="RepLog" textFill="#e1b531">
                    <font>
                        <Font name="System Bold" size="30.0" />
                    </font>
                </Label>
                <Region prefHeight="60.0" prefWidth="400.0" HBox.hgrow="ALWAYS" />
                <Button fx:id="homeButton" onAction="#onHomeClicked" mnemonicParsing="false" style="-fx-background-color: #252525; -fx-border-color: #e1b531;" styleClass="primary-button" text="Home" textFill="#e1b531">
                    <font>
                        <Font size="16.0" />
                    </font>
                    <HBox.margin>
                        <Insets right="5.0" />
                    </HBox.margin>
                </Button>
                <Button fx:id="historyButton" onAction="#onHistoryClicked" mnemonicParsing="false" style="-fx-background-color: #252525; -fx-border-color: #e1b531;" styleClass="primary-button" text="History" textFill="#e1b531">
                    <font>
                        <Font size="16.0" />
                    </font>
                    <HBox.margin>
                        <Insets right="25.0" />
                    </HBox.margin>
                </Button>
                <Button fx:id="logoutButton" onAction="#onLogoutClicked" alignment="CENTER" mnemonicParsing="false" style="-fx-background-color: #252525; -fx-border-color: #e1b531;" styleClass="secondary-button" text="Logout" textFill="#e1b531">
                    <font>
                        <Font size="14.0" />
                    </font>
                    <HBox.margin>
                        <Insets right="10.0" />
                    </HBox.margin>
                </Button>
            </children>
        </HBox>
    </top>

    <center>
        <VBox spacing="6.0" style="-fx-background-color: #252525;">
            <padding>
                <Insets bottom="20.0" left="40.0" right="40.0" top="30.0" />
            </padding>
            <children>
                <Label fx:id="titleLabel" styleClass="page-title" text="Time to start the grind!" textFill="#e1b531">
                    <font>
                        <Font name="System Bold" size="36.0" />
                    </font>
                </Label>

                <Label fx:id="emptyLabel" managed="false" styleClass="page-subtitle" text="You don't have any workouts here yet." textFill="#e1b531" visible="false">
                    <font>
                        <Font name="System Italic" size="16.0" />
                    </font>
                </Label>

                <Label fx:id="errorLabel" styleClass="error-label" textFill="#e05252" wrapText="true">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>

                <ScrollPane fx:id="workoutScroll" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: #252525; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                    <VBox.margin>
                        <Insets top="14.0" />
                    </VBox.margin>
                    <content>
                        <VBox fx:id="workoutList" spacing="8.0" style="-fx-background-color: #252525;">
                            <padding>
                                <Insets bottom="10.0" right="8.0" />
                            </padding>
                        </VBox>
                    </content>
                </ScrollPane>

                <Button fx:id="finishButton" onAction="#onFinishClicked" mnemonicParsing="false" style="-fx-background-color: #323232; -fx-border-color: #e1b531;" styleClass="primary-button" text="Finish Workout" textFill="#e1b531">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </Button>
            </children>
        </VBox>
    </center>
</BorderPane>