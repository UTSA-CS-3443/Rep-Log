<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #141414; -fx-border-color: #e1b531;" styleClass="root-pane" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="542.0" prefHeight="617.0" prefWidth="542.0" spacing="8.0" style="-fx-background-color: #252525; -fx-border-color: #e1b531;" styleClass="form-card">
            <padding>
                <Insets bottom="28.0" left="28.0" right="28.0" top="20.0" />
            </padding>
            <children>

                <ImageView fx:id="logoImageView" fitHeight="80.0" fitWidth="80.0" pickOnBounds="true" preserveRatio="true" />
                <Label styleClass="page-title" text="Account Information" textFill="#e1b531">
                    <font>
                        <Font name="System Bold" size="30.0" />
                    </font>
                </Label>
                <Label styleClass="page-subtitle" text="Tell us a little about yourself" textFill="#e1b531">
                    <font>
                        <Font size="16.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="6.0" top="-4.0" />
                    </VBox.margin>
                </Label>

                <VBox alignment="CENTER_LEFT" spacing="4.0">
                    <children>
                        <Label styleClass="field-label" text="Name" textFill="#e1b531">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <TextField fx:id="nameField" promptText="Enter your name" style="-fx-background-color: #323232; -fx-text-fill: white;" />
                    </children>
                </VBox>
                <VBox alignment="CENTER_LEFT" spacing="4.0">
                    <children>
                        <Label styleClass="field-label" text="Age" textFill="#e1b531">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <TextField fx:id="ageField" promptText="Enter your age" style="-fx-background-color: #323232; -fx-text-fill: white;" />
                    </children>
                </VBox>
                <VBox alignment="CENTER_LEFT" spacing="4.0">
                    <children>
                        <Label styleClass="field-label" text="Starting Weight (lbs)" textFill="#e1b531">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <TextField fx:id="startingWeightField" promptText="Enter your starting weight" style="-fx-background-color: #323232; -fx-text-fill: white;" />
                    </children>
                </VBox>
                <VBox alignment="CENTER_LEFT" spacing="4.0">
                    <children>
                        <Label styleClass="field-label" text="Password" textFill="#e1b531">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <PasswordField fx:id="passwordField" promptText="Create a password" style="-fx-background-color: #323232; -fx-text-fill: white;" />
                    </children>
                </VBox>

                <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" />

                <Button fx:id="saveButton" defaultButton="true" maxWidth="250.0" mnemonicParsing="false" style="-fx-background-color: #323232; -fx-border-color: #e1b531;" styleClass="primary-button" text="Save" textFill="#e1b531">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>
                <Button fx:id="cancelButton" maxWidth="250.0" mnemonicParsing="false" style="-fx-background-color: #323232; -fx-border-color: #e1b531;" styleClass="secondary-button" text="Cancel" textFill="#e1b531">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>
                <Button fx:id="deleteButton" maxWidth="250.0" mnemonicParsing="false" style="-fx-background-color: #323232; -fx-border-color: e05252;" styleClass="secondary-button" text="Delete" textFill="#e05252">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>
            </children>
        </VBox>
    </children>
</StackPane>
