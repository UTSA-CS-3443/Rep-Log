<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #141414; -fx-border-color: e1b531;" styleClass="root-pane" stylesheets="@replog.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="542.0" prefHeight="601.0" prefWidth="542.0" spacing="12.0" style="-fx-background-color: #252525; -fx-border-color: e1b531;" styleClass="form-card">
            <padding>
                <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
            </padding>
            <children>
                <ImageView fx:id="logoImageView" fitHeight="225.0" fitWidth="225.0" pickOnBounds="true" preserveRatio="true" />
                <Label styleClass="page-title" text="RepLog" textFill="#e1b531">
               <font>
                  <Font name="System Bold" size="36.0" />
               </font></Label>
                <Label styleClass="page-subtitle" text="Log in to continue" textFill="#e1b531">
               <font>
                  <Font size="16.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="10.0" top="-10.0" />
               </VBox.margin></Label>
                <VBox alignment="CENTER_LEFT" spacing="4.0">
                    <children>
                        <Label styleClass="field-label" text="Username" textFill="#e1b531">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font></Label>
                        <TextField fx:id="usernameField" promptText="Enter your username" style="-fx-background-color: #323232;" />
                    </children>
                </VBox>
                <VBox alignment="CENTER_LEFT" spacing="4.0">
                    <children>
                        <Label styleClass="field-label" text="Password" textFill="#e1b531">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font></Label>
                        <PasswordField fx:id="passwordField" promptText="Enter your password" style="-fx-background-color: #323232;" />
                    </children>
                </VBox>
                <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" />
                <Button fx:id="loginButton" defaultButton="true" maxWidth="250.0" mnemonicParsing="false" style="-fx-background-color: #323232; -fx-border-color: e1b531;" styleClass="primary-button" text="Log In" textFill="#e1b531">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font></Button>
                <Button fx:id="addAccountButton" maxWidth="250.0" mnemonicParsing="false" style="-fx-background-color: #323232; -fx-border-color: e1b531;" styleClass="secondary-button" text="Create Account" textFill="#e1b531">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font></Button>
            </children>
        </VBox>
    </children>
</StackPane>
