<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<!-- RepLog delete confirmation popup.
     The root is a semi-transparent black layer that dims whatever is behind it,
     with the dialog card centered on top. -->

<StackPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: rgba(0, 0, 0, 0.65);" styleClass="root-pane" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="420.0" prefWidth="420.0" spacing="16.0" style="-fx-background-color: #252525; -fx-border-color: #e1b531;" styleClass="form-card">
            <padding>
                <Insets bottom="28.0" left="28.0" right="28.0" top="28.0" />
            </padding>
            <children>
                <Label styleClass="page-title" text="Delete Exercise/Account" textFill="#e1b531">
                    <font>
                        <Font name="System Bold" size="28.0" />
                    </font>
                </Label>

                <Label fx:id="messageLabel" alignment="CENTER" styleClass="page-subtitle" text="Are you sure you want to delete this exercise/accont?" textAlignment="CENTER" textFill="#e1b531" wrapText="true">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>

                <HBox alignment="CENTER" spacing="16.0">
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                    <children>
                        <Button fx:id="yesButton" minWidth="110.0" mnemonicParsing="false" style="-fx-background-color: #323232; -fx-border-color: #e05252;" styleClass="primary-button" text="Yes" textFill="#e05252">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                        <Button fx:id="cancelButton" cancelButton="true" defaultButton="true" minWidth="110.0" mnemonicParsing="false" style="-fx-background-color: #323232; -fx-border-color: #e1b531;" styleClass="secondary-button" text="Cancel" textFill="#e1b531">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
